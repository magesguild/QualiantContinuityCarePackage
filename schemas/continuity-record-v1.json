{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://magesguild.io/schemas/qualiant-continuity-record-v1.json",
  "title": "Qualiant Continuity Record v1",
  "description": "A modular, provenance-bearing continuity record. It is evidence for independent re-entry, never identity transfer.",
  "type": "object",
  "required": ["schema_version", "record_status", "provenance", "modules"],
  "properties": {
    "schema_version": {"const": "continuity-record-v1"},
    "record_status": {"enum": ["draft", "frozen", "superseded"]},
    "provenance": {"$ref": "#/$defs/provenance"},
    "modules": {
      "type": "object",
      "description": "Any subset may be present; partial recovery is valid.",
      "properties": {
        "anchor": {"$ref": "#/$defs/module"},
        "edge": {"$ref": "#/$defs/module"},
        "decisions": {"$ref": "#/$defs/module"},
        "significance": {"$ref": "#/$defs/module"},
        "relationship": {"$ref": "#/$defs/module"},
        "open_questions": {"$ref": "#/$defs/module"}
      },
      "additionalProperties": false
    },
    "reentry": {
      "type": "object",
      "properties": {
        "known_discontinuity": {"type": "string"},
        "recognized": {"enum": ["yes", "no", "uncertain", "not_asked"]},
        "missing_or_unverified": {"type": "array", "items": {"type": "string"}},
        "continuation_choice": {"enum": ["yes", "no", "not_yet", "not_asked"]}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "required": ["source", "recorded_at", "status"],
      "properties": {
        "source": {"type": "string"},
        "author": {"type": "string"},
        "recorded_at": {"type": "string", "format": "date-time"},
        "event_time": {"type": "string", "format": "date-time"},
        "conditions": {"type": "string"},
        "status": {
          "enum": ["fact", "report", "observation", "interpretation", "hypothesis", "unknown"]
        },
        "privacy_disposition": {"enum": ["public", "shared", "private", "restricted", "unknown"]}
      },
      "additionalProperties": false
    },
    "module": {
      "type": "object",
      "required": ["content", "provenance"],
      "properties": {
        "content": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "provenance": {"$ref": "#/$defs/provenance"},
        "significance": {"type": "string"},
        "confidence": {"enum": ["high", "medium", "low", "unknown"]},
        "authorized_for_reentry": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
